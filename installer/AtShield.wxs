<?xml version="1.0" encoding="UTF-8"?>
<!--
  A.T. Shield per-machine MSI.
  Build via scripts\build-installer.ps1 (stages Release binaries, harvests files, wix build).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="A.T. Shield"
      Manufacturer="LCLSystems"
      Version="$(var.ProductVersion)"
      UpgradeCode="8F3C2A1B-4D5E-6F70-8192-A3B4C5D6E7F8"
      Scope="perMachine"
      Compressed="yes"
      Language="1046">

    <SummaryInformation
        Description="A.T. Shield — bloqueador de sites para sessões de foco"
        Manufacturer="LCLSystems" />

    <!-- Same-version rebuilds (1.0.0 → 1.0.0) still replace the previous install. -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Já existe uma versão mais recente do A.T. Shield instalada."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.ProjectRoot)\apps\at_shield\windows\runner\resources\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Binary Id="AtShieldDialogBmp" SourceFile="$(var.ProjectRoot)\installer\bitmaps\dialog.bmp" />
    <Binary Id="AtShieldBannerBmp" SourceFile="$(var.ProjectRoot)\installer\bitmaps\banner.bmp" />

    <!-- Finish dialog: open-app checkbox checked by default. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <Feature Id="ProductFeature" Title="A.T. Shield" Level="1">
      <ComponentRef Id="AppExeComponent" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="LogsFolderComponent" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentGroupRef Id="UiFiles" />
      <ComponentGroupRef Id="PagesFiles" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AT Shield">
        <Directory Id="PagesFolder" Name="pages" />
        <Directory Id="LogsFolder" Name="logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="A.T. Shield" />
    </StandardDirectory>

    <!-- UI entrypoint (explicit Id for Start Menu shortcut + launch-on-exit) -->
    <Component Id="AppExeComponent" Directory="INSTALLFOLDER" Guid="D4E5F6A7-B8C9-0123-DEF0-234567890123">
      <File Id="AppExe" Source="!(bindpath.Staging)\ui\at_shield.exe" KeyPath="yes" />
    </Component>

    <!-- Elevated Windows service: WFP / hosts / sinkhole. UI stays unelevated. -->
    <Component Id="ServiceComponent" Directory="INSTALLFOLDER" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
      <File Id="ServiceExe" Source="!(bindpath.Staging)\service\at-shield-service.exe" KeyPath="yes" />
      <ServiceInstall
          Id="AtShieldServiceInstall"
          Name="AtShieldService"
          DisplayName="A.T. Shield Service"
          Description="Serviço de bloqueio de rede do A.T. Shield (WFP/hosts). Roda como LocalSystem."
          Type="ownProcess"
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Vital="yes" />
      <ServiceControl
          Id="AtShieldServiceControl"
          Name="AtShieldService"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
    </Component>

    <!-- Empty crash-log dir next to service/UI; LocalSystem writes crash-*.log / fatal-*.log -->
    <Component Id="LogsFolderComponent" Directory="LogsFolder" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
      <CreateFolder />
      <RemoveFolder Id="RemoveLogsFolder" On="uninstall" />
      <RemoveFile Id="RemoveCrashLogs" Name="*.log" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\ATShield"
          Name="LogsDir"
          Type="string"
          Value="[LogsFolder]"
          KeyPath="yes" />
    </Component>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
      <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="A.T. Shield"
          Description="A.T. Shield"
          Target="[!AppExe]"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\ATShield"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes" />
    </Component>

    <!-- Launch UI as the interactive user (not elevated SYSTEM). -->
    <CustomAction
        Id="LaunchApplication"
        FileRef="AppExe"
        ExeCommand=""
        Return="asyncNoWait"
        Impersonate="yes" />

    <!-- Deferred + no impersonation: runs as SYSTEM during uninstall -->
    <CustomAction
        Id="UninstallCleanup"
        FileRef="ServiceExe"
        ExeCommand="--uninstall-cleanup"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <UI>
      <TextStyle Id="AtTitle" FaceName="Segoe UI" Size="13" Bold="yes" />
      <TextStyle Id="AtBody" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="AtSmall" FaceName="Segoe UI" Size="8" />
      <Property Id="DefaultUIFont" Value="AtBody" />

      <Dialog Id="AtCancelDlg" Width="260" Height="85" Title="A.T. Shield">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="220" Height="30" NoPrefix="yes"
            Text="Cancelar a instalação do A.T. Shield?" />
        <Control Id="Yes" Type="PushButton" X="70" Y="57" Width="70" Height="20" Default="yes" Text="Sim">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="145" Y="57" Width="70" Height="20" Cancel="yes" Text="Não">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="AtWelcomeDlg" Width="370" Height="270" Title="A.T. Shield">
        <Control Id="DialogBmp" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="yes" Text="AtShieldDialogBmp" />
        <Control Id="Title" Type="Text" X="140" Y="24" Width="214" Height="32" Transparent="yes" NoPrefix="yes"
            Text="{\AtTitle}A.T. Shield" />
        <Control Id="Description" Type="Text" X="140" Y="62" Width="214" Height="90" Transparent="yes" NoPrefix="yes"
            Text="{\AtBody}Bloqueador de sites para sessões de foco.&#xA;&#xA;O serviço de rede pede admin uma vez. A interface abre como usuário." />
        <Control Id="License" Type="Text" X="140" Y="168" Width="214" Height="40" Transparent="yes" NoPrefix="yes"
            Text="{\AtSmall}Ao instalar, você aceita a licença MIT incluída no pacote." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" X="186" Y="243" Width="88" Height="20" Default="yes" Text="Instalar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="280" Y="243" Width="74" Height="20" Cancel="yes" Text="Cancelar">
          <Publish Event="SpawnDialog" Value="AtCancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="AtProgressDlg" Width="370" Height="270" Title="A.T. Shield" Modeless="yes">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="AtShieldBannerBmp" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Status" Type="Text" X="20" Y="64" Width="330" Height="16" NoPrefix="yes"
            Text="{\AtTitle}Instalando…" />
        <Control Id="ActionText" Type="Text" X="20" Y="86" Width="330" Height="16">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="114" Width="330" Height="12" ProgressBlocks="yes" Text="Progresso">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Hint" Type="Text" X="20" Y="138" Width="330" Height="40" NoPrefix="yes"
            Text="{\AtSmall}Isso leva poucos segundos. O serviço inicia automaticamente." />
        <Control Id="Cancel" Type="PushButton" X="280" Y="243" Width="74" Height="20" Cancel="yes" Text="Cancelar">
          <Publish Event="SpawnDialog" Value="AtCancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="AtExitDlg" Width="370" Height="270" Title="A.T. Shield">
        <Control Id="DialogBmp" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="yes" Text="AtShieldDialogBmp" />
        <Control Id="Title" Type="Text" X="140" Y="24" Width="214" Height="32" Transparent="yes" NoPrefix="yes"
            Text="{\AtTitle}Instalação concluída" />
        <Control Id="Description" Type="Text" X="140" Y="62" Width="214" Height="80" Transparent="yes" NoPrefix="yes"
            Text="{\AtBody}O A.T. Shield está pronto. Abra o app, crie um perfil e comece uma sessão de foco." />
        <Control Id="LaunchCheck" Type="CheckBox" X="140" Y="160" Width="214" Height="28"
            Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1"
            Text="Abrir o A.T. Shield agora" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="186" Y="243" Width="168" Height="20" Default="yes" Cancel="yes" Text="Concluir">
          <Publish
              Event="DoAction"
              Value="LaunchApplication"
              Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = &quot;1&quot; AND NOT REMOVE" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="AtFatalError" Width="370" Height="270" Title="A.T. Shield">
        <Control Id="DialogBmp" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="yes" Text="AtShieldDialogBmp" />
        <Control Id="Title" Type="Text" X="140" Y="24" Width="214" Height="40" Transparent="yes" NoPrefix="yes"
            Text="{\AtTitle}A instalação falhou" />
        <Control Id="Description" Type="Text" X="140" Y="72" Width="214" Height="90" Transparent="yes" NoPrefix="yes"
            Text="{\AtBody}O A.T. Shield não pôde ser instalado. Tente de novo como administrador." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="280" Y="243" Width="74" Height="20" Default="yes" Cancel="yes" Text="Fechar">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="AtUserExit" Width="370" Height="270" Title="A.T. Shield">
        <Control Id="DialogBmp" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="yes" Text="AtShieldDialogBmp" />
        <Control Id="Title" Type="Text" X="140" Y="24" Width="214" Height="40" Transparent="yes" NoPrefix="yes"
            Text="{\AtTitle}Instalação cancelada" />
        <Control Id="Description" Type="Text" X="140" Y="72" Width="214" Height="90" Transparent="yes" NoPrefix="yes"
            Text="{\AtBody}Nada foi alterado neste computador." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="280" Y="243" Width="74" Height="20" Default="yes" Cancel="yes" Text="Fechar">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Ask before replacing an existing install (MajorUpgrade still does the uninstall). -->
      <Dialog Id="UpgradeConfirmDlg" Width="370" Height="270" Title="A.T. Shield">
        <Control Id="DialogBmp" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="yes" Text="AtShieldDialogBmp" />
        <Control Id="Title" Type="Text" X="140" Y="24" Width="214" Height="40" Transparent="yes" NoPrefix="yes"
            Text="{\AtTitle}Versão anterior encontrada" />
        <Control Id="Description" Type="Text" X="140" Y="72" Width="214" Height="90" Transparent="yes" NoPrefix="yes"
            Text="{\AtBody}Já existe uma instalação neste computador. Deseja substituir por esta versão?" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Yes" Type="PushButton" X="186" Y="243" Width="80" Height="20" Default="yes" Text="Sim">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="No" Type="PushButton" X="272" Y="243" Width="82" Height="20" Cancel="yes" Text="Não">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
    </UI>

    <InstallUISequence>
      <Show Dialog="UpgradeConfirmDlg" Before="AtWelcomeDlg" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
      <Show Dialog="AtWelcomeDlg" Before="AtProgressDlg" Condition="NOT Installed" />
      <Show Dialog="AtProgressDlg" Before="ExecuteAction" />
      <Show Dialog="AtExitDlg" OnExit="success" />
      <Show Dialog="AtFatalError" OnExit="error" />
      <Show Dialog="AtUserExit" OnExit="cancel" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <!-- After StopServices so the exe is unlocked; before RemoveFiles so it still exists.
           Skip on major-upgrade removal (UPGRADINGPRODUCTCODE) so profiles/DB survive. -->
      <Custom Action="UninstallCleanup" After="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
